{
  "folders": [
    {
      "name": "gitenv",
      "path": ".",
    },
    {
      "name": "gitenv-rust",
      "path": "rust",
    },
  ],
  "settings": {
    "chat.tools.terminal.autoApprove": {
      "/^\\s*(?:bash +)?(?:\\.\\/)?\\.agent\\/scripts\\/(?:build|coverage|format|lint|lint-md|tests)\\.sh(?:\\s*2>&1)?(?:\\s*\\|\\s*tail\\s+-\\d+)?\\s*$/": {
        "approve": true,
        "matchCommandLine": true,
      },
      "/^\\s*cargo\\s+check(?:\\s+--quiet)?(?:\\s+2>&1)?(?:\\s*|\\s*head\\s+-\\d+)?\\s*$/": {
        "approve": true,
        "matchCommandLine": true,
      },
      "^\\s*git\\s+status(?:\\s+--short)?\\s*$": {
        "approve": true,
        "matchCommandLine": true,
      },
      "^\\s*tail\\s+-\\d+\\s+tmp\\/agent\\/[a-zA-Z0-9_]+(?:\\.[a-zA-Z0-9_]+)*\\s*$": {
        "approve": true,
        "matchCommandLine": true,
      },
      "^\\s*wc\\s+-l\\s+[a-zA-Z0-9_-]+(?:\\/[a-zA-Z0-9_-)*\\s*$": {
        "approve": true,
        "matchCommandLine": true,
      },
    },
    "chat.tools.terminal.enableAutoApprove": true,
    "chat.tools.terminal.ignoreDefaultAutoApproveRules": true,
    "rust-analyzer.linkedProjects": ["rust/Cargo.toml"],
  },
}
